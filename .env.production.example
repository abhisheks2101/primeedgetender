# Production environment template
# Copy to .env.production and replace all placeholder values.

APP_NAME=Tender Intelligence Platform
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://your-frontend-domain.example

POSTGRES_USER=tender_user
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=tender_intelligence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tender_user:replace_with_strong_password@postgres:5432/tender_intelligence

NEXT_PUBLIC_API_URL=http://backend:8000
FRONTEND_PORT=3000

LOG_LEVEL=INFO
