# Application
APP_NAME=Tender Intelligence Platform
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
