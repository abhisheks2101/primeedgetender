# Application
APP_NAME=Tender Intelligence Platform
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=tender_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tender_user:change_me_in_production@localhost:5432/tender_intelligence

# Authentication
AUTH_SECRET=replace_with_a_long_random_secret_in_local_env
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=tip_session
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_PUBLIC_REGISTRATION=false
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000
FRONTEND_PORT=3000

# End-to-end testing
E2E_BASE_URL=http://localhost:3000
E2E_TEST_EMAIL=e2e.user@example.com
E2E_TEST_PASSWORD=Password123
E2E_TEST_FULL_NAME=E2E Test User

# Logging
LOG_LEVEL=INFO

# Document storage
UPLOAD_STORAGE_PATH=storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
DOCUMENT_EXPIRING_SOON_DAYS=30
